{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecureuil-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ecureuil",
      // Placeholder until the production database exists (deployment task).
      // Local dev (`wrangler dev`) uses a local SQLite file regardless of this id.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
