language js

JsPropertyObjectMember(name=$n) as $m where {
  $n <: "_tag",
  $filename <: not r".*\.test\.tsx?$",
  register_diagnostic(span=$m, message="Don't write `_tag` in an object literal: build tagged values with their Effect constructor, `Data.taggedEnum` or `Schema.TaggedUnion` `.cases.X.make(...)`.")
}
